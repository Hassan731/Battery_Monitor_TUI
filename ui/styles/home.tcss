#home-grid {
    width: 100%;
    height: 1fr;
}

#col-main {
    width: 2fr;
}

#col-bb {
    width: 1fr;
    height: 100%;
}

#col-mid {
    width: 1fr;
    height: 100%;
}

#col-right {
    width: 1fr;
    height: 100%;
}


FeatureCard {
    padding: 1 1;
    height: auto;
    margin: 1;
}

#col-mid FeatureCard {
    height: 1fr;
}

#col-right FeatureCard {
    height: 1fr;
}

#col-bb FeatureCard {
    height: 1fr;
    align: left middle;
}

.card-icon {
    text-style: bold;
}

.card-name {
    text-style: bold;
}

.card-bb {
    background: #001a2e;
    border: round #003a5a;
    color: #00cfff;
}

.card-live {
    background: #001a14;
    border: round #005229;
    color: #00e5a0;
}

.card-did {
    background: #1a0e2e;
    border: round #4a1a8a;
    color: #c084fc;
}

.card-sniff {
    background: #1a1000;
    border: round #7a4a00;
    color: #ffb84d;
}

.card-routine {
    background: #1a0014;
    border: round #7a0050;
    color: #ff80c0;
}

.card-set {
    background: #0f0f0f;
    border: round #2a2a2a;
    color: #888880;
}