/* ─────────────────────────────────────────────
   HOME SCREEN — home.tcss
───────────────────────────────────────────── */


/* ── Grid layout ─────────────────────────────
   2 columns, 3 rows, fills all available space
   between Header and StatusBar               */

#home-grid {
    grid-size: 2 3;         /* 2 columns, 3 rows */
    grid-gutter: 1;         /* gap between cells */
    padding: 1;
    height: 1fr;
    width: 100%;
}


/* ── FeatureCard: base ───────────────────────
   Horizontal layout — icon left, text right
   Accent bar on left via border-left         */

FeatureCard {
    layout: horizontal;
    align: left middle;
    padding: 0 2;
    background: #0f1118;
    border-left: tall #333;
    height: 1fr;
}


/* ── Card icon ───────────────────────────────
   Fixed width so text always aligns          */

.card-icon {
    width: 6;               /* wider cell for the icon */
    text-style: bold;
    content-align: center middle;
    text-style: bold;
}

/* ── Card text block ─────────────────────────
   Name + description stacked vertically      */

.card-text {
    height: auto;
    width: 1fr;
}

.card-name {
    text-style: bold;
}

.card-desc {
    color: #4a5568;
}


/* ── Card themes ─────────────────────────────
   Each card gets its accent color on the
   left border, icon, and name                */

.card-bb      { border-left: tall #00cfff; color: #00cfff; }
.card-live    { border-left: tall #00e5a0; color: #00e5a0; }
.card-did     { border-left: tall #c084fc; color: #c084fc; }
.card-sniff   { border-left: tall #ffb84d; color: #ffb84d; }
.card-routine { border-left: tall #ff80c0; color: #ff80c0; }
.card-set     { border-left: tall #888880; color: #888880; }


/* ── Hover states ────────────────────────────
   Subtle background lift when mouse is over
   the card. Does not move keyboard focus —
   only adds a visual cue.
   Each card uses a slightly lighter version
   of its own background color               */

.card-bb:hover     { background: #002a40; }
.card-live:hover   { background: #002a1a; }
.card-did:hover    { background: #2a1848; }
.card-sniff:hover  { background: #2a1e08; }
.card-routine:hover{ background: #2a0828; }
.card-set:hover    { background: #1a1a1a; }


/* ── Focus states ────────────────────────────
   Focused card gets a bright colored border.
   Triggered by keyboard nav or mouse click.
   FeatureCard.focused is a fallback for any
   card added without its own focused rule    */

FeatureCard.focused {
    border: tall white;
}

.card-bb.focused      { border: tall #00cfff; }
.card-live.focused    { border: tall #00e5a0; }
.card-did.focused     { border: tall #c084fc; }
.card-sniff.focused   { border: tall #ffb84d; }
.card-routine.focused { border: tall #ff80c0; }
.card-set.focused     { border: tall #888880; }


/* ── Hover + focused combined ────────────────
   When the mouse is over the already-focused
   card, brighten the background further.
   Both classes are present simultaneously
   so this rule only fires in that exact case */

.card-bb.focused:hover     { background: #003a50; }
.card-live.focused:hover   { background: #003a22; }
.card-did.focused:hover    { background: #3a2058; }
.card-sniff.focused:hover  { background: #3a2810; }
.card-routine.focused:hover{ background: #3a1030; }
.card-set.focused:hover    { background: #222222; }