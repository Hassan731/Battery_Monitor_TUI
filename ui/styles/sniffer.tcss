/* ─────────────────────────────────────────────
   SNIFFER SCREEN — sniffer.tcss
───────────────────────────────────────────── */


/* ── Screen body ─────────────────────────────
   Fills all space between toolbar and
   StatusBar                                  */

#sniffer-body {
    width: 100%;
    height: 1fr;
    background: #070b10;
}


/* ── Toolbar container ───────────────────────
   Simple state display row — no buttons      */

#sniffer-toolbar {
    height: 3;
    background: #0a0f18;
    border-bottom: tall #0f1825;
    padding: 0 2;
    align: left middle;
    width: 100%;
}

#sniffer-toolbar Label {
    height: 3;
    content-align: left middle;
    padding: 0 1;
    background: #0a0f18;
}


/* ── State indicator ─────────────────────────
   Green when running, amber when paused      */

#tb-state          { color: #00a870; }   /* running — green  */
#tb-state.paused   { color: #e8a44a; }   /* paused  — amber  */


/* ── Mode indicator ─────────────────────────
   Shows current view mode                   */

#tb-mode            { color: #2a4060; }
#tb-mode.stats-active { color: #c084fc; }


/* ── Frame counter ───────────────────────────
   Docked to the right of the toolbar        */

#tb-count {
    dock: right;
    color: #2a4060;
    padding-right: 2;
}


/* ── Separator ───────────────────────────────*/

.tb-sep {
    color: #1a2535;
    padding: 0;
}

/* ── Frame table ─────────────────────────────
   Main content area — fills all remaining
   space below the toolbar                    */

#frame-table {
    width: 100%;
    height: 1fr;
    background: #070b10;
}

DataTable {
    background: #070b10;
    color: #4a5568;
}

DataTable > .datatable--header {
    background: #0a0f18;
    color: #1e3a50;
    text-style: none;
}

DataTable > .datatable--cursor {
    background: #111d2a;
    color: #7db8f7;
}

DataTable > .datatable--zebra-stripe {
    background: #080c12;
}


/* ── Detail panel ────────────────────────────
   Shows selected frame info below the table  */

#detail-panel {
    height: 5;
    background: #090b10;
    border-top: tall #0f1825;
    padding: 0 1;
}

.detail-cell {
    width: 1fr;
    height: 5;
    padding: 0 2;
    border-right: tall #0f1825;
    align: left middle;
}

.detail-cell:last-of-type {
    border-right: none;
    width: 2fr;        /* decoded gets more space */
}

.detail-label {
    color: #1a2a3a;
    text-style: none;
}

.detail-cell Label:last-of-type {
    color: #7db8f7;
    text-style: bold;
}